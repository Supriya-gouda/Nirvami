# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI API (Required for chatbot)
GEMINI_API_KEY=your-gemini-api-key

# YouTube API (for practice videos)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Twilio SMS Service (Required for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number-with-country-code

# Application Settings
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ML Models (Auto-downloads on first run)
MODEL_CACHE_DIR=./models_cache
EMOTION_MODEL=SamLowe/roberta-base-go_emotions

# Features
CRISIS_ALERT_ENABLED=true
