# ==========================================
# REQUIRED Environment Variables
# ==========================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database (Use your Supabase PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:port/database

# Google Gemini API (Required for AI chatbot)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Application Security
SECRET_KEY=your-secret-key-here-generate-random-string
ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ==========================================
# ML Models Configuration
# ==========================================

MODEL_CACHE_DIR=./models_cache
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMOTION_MODEL=SamLowe/roberta-base-go_emotions
ENABLE_ML_MODELS=true
USE_MOCK_DATA=false

# ==========================================
# OPTIONAL Features (Can leave empty)
# ==========================================

# YouTube API (Optional - for practice videos)
YOUTUBE_API_KEY=

# Twilio SMS (Optional - for crisis alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@nirvami.app
